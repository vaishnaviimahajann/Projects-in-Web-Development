<% layout("layouts/boilerplate") %>

<div class="row mt-4">
  <div class="col-8 offset-2">

    <h3 class="mb-4">Edit Your Listing</h3>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">

      <!-- Title -->
      <div class="mb-3">
        <label class="form-label">Title</label>
        <input 
          name="listings[title]" 
          value="<%= listing.title %>" 
          type="text" 
          class="form-control"
          required
        >
        <div class="valid-feedback">Title looks good</div>
      </div>

      <!-- Description -->
      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea 
          name="listings[description]" 
          class="form-control" 
          rows="4"
          required
        ><%= listing.description %></textarea>
        <div class="invalid-feedback">Description should be valid</div>
      </div>

      <!-- Image -->

       <div class="mb-3">
  <p>Original Image</p>
  <img 
    src="<%= listing.image.url %>" 
    class="img-fluid"
    style="max-width: 300px; border-radius: 10px;"
  >
</div>

      <div class="mb-3" >
        <label class="form-label">Upload New Image</label>
        <input 
          name="image"
          type="file" 
          class="form-control"

        >
      </div>

      <!-- 🔥 FIXED ROW (Price + Country + Location) -->
      <div class="row">

        <!-- Price -->
        <div class="mb-3 col-md-4">
          <label class="form-label">Price</label>
          <input 
            name="listings[price]" 
            value="<%= listing.price %>" 
            type="text" 
            class="form-control"
            required
          >
          <div class="invalid-feedback">Enter a valid number</div>
        </div>

        <!-- Country -->
        <div class="mb-3 col-md-4">
          <label class="form-label">Country</label>
          <input 
            name="listings[country]" 
            value="<%= listing.country %>" 
            type="text" 
            class="form-control"
            required
          >
          <div class="invalid-feedback">Country should be valid</div>
        </div>

        <!-- Location -->
        <div class="mb-3">
          <label class="form-label">Location</label>
          <input 
            name="listings[location]" 
            value="<%= listing.location %>" 
            type="text" 
            class="form-control"
            required
          >
          <div class="invalid-feedback">Location should be valid</div>
        </div>

      </div>

      <!-- 🔥 BUTTON FIX -->
  
        <button class="btn btn-danger  mt-1">Edit</button>
      

    </form>

  </div>
</div>